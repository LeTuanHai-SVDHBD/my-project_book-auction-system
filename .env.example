NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=5000
CLIENT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DB_SERVER=127.0.0.1
DB_PORT=14330
DB_DATABASE=BookAuctionDB
DB_USER=sa
DB_PASSWORD=CHANGE_ME_RUN_NPM_SETUP
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_TIMEOUT_MS=5000
# Tên volume dành cho máy cài mới; máy đã có dữ liệu giữ cấu hình .env hiện tại.
SQLSERVER_VOLUME_NAME=my-project_book-auction-system_sqlserver_data
REDIS_VOLUME_NAME=my-project_book-auction-system_redis_data
REDIS_URL=redis://127.0.0.1:63790
DEV_PROBE_TOKEN=CHANGE_ME_RUN_NPM_SETUP
LOG_LEVEL=info

# Session đăng nhập: tạo bằng npm run setup:auth, không đưa secret thật vào Git.
SESSION_SECRET=CHANGE_ME_RUN_NPM_SETUP_AUTH
SESSION_IDLE_SECONDS=7200

# Mốc 4: chỉ backend đọc ba giá trị Cloudinary; không dùng biến VITE_* cho bí mật.
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
MEDIA_IMAGE_MAX_MB=10
MEDIA_VIDEO_MAX_MB=50
MEDIA_MAX_IMAGES=12
MEDIA_MAX_VIDEOS=3

# Gemini chỉ backend; bật sau khi đã điền API key
AI_ENABLED=false
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-3.8-flash
AI_PROVIDER_TIMEOUT_MS=60000
AI_MEDIA_TOTAL_MB=12
