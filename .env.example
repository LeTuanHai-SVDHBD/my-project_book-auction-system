# Mục đích: Cấu hình mẫu API, worker và Docker; không chứa bí mật thật.
# npm run setup tạo .env riêng và sinh mật khẩu/token.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=5000
CLIENT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DB_SERVER=127.0.0.1
DB_PORT=14330
DB_DATABASE=BookAuctionDB
DB_USER=sa
DB_PASSWORD=CHANGE_ME_RUN_NPM_SETUP
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_TIMEOUT_MS=5000
REDIS_URL=redis://127.0.0.1:63790
DEV_PROBE_TOKEN=CHANGE_ME_RUN_NPM_SETUP
LOG_LEVEL=info

# Tên volume cho máy cài mới. Máy đang có dữ liệu xem docs/docker-migration.md.
SQLSERVER_VOLUME_NAME=my-project_book-auction-system_sqlserver_data
REDIS_VOLUME_NAME=my-project_book-auction-system_redis_data
