# node scripts/setupDeployment.mjs tạo .env.deploy; không dùng .env phát triển.
# Sửa thành URL HTTPS thật, không thêm dấu / ở cuối.
BOOKBID_ORIGIN=https://bookbid.example.com
BOOKBID_PORT=8080
SQL_DATABASE=BookAuctionDeploy
SQL_SA_PASSWORD=CHANGE_ME
SQL_APP_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME
DEV_PROBE_TOKEN=CHANGE_ME

# Tùy chọn: chỉ điền trong .env.deploy trên máy chạy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
