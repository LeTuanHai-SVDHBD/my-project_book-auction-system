{
  "name": "my-project-book-auction-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:auth": "node scripts/setupAuth.mjs",
    "admin:create": "npm run admin:create --workspace backend",
    "smoke:auth": "node scripts/smokeAuth.mjs",
    "db:init": "npm run db:init --workspace backend",
    "dev:api": "npm run dev:api --workspace backend",
    "dev:worker": "npm run dev:worker --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "check": "node scripts/check.mjs",
    "test": "npm test --workspace backend",
    "build": "npm run build --workspace frontend",
    "smoke": "node scripts/smoke.mjs",
    "db:migrate": "npm run db:migrate --workspace backend",
    "setup:media": "node scripts/setupMedia.mjs",
    "smoke:m4": "node scripts/smokeM4.mjs"
  }
}
